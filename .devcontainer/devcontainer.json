{
    "name": "DuQuantum - Pasqal Hackathon",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "remoteUser": "vscode",
    "remoteEnv": {
        "UV_PROJECT_ENVIRONMENT": "${containerWorkspaceFolder}/.venv",
        "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
        "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
    },
    "postCreateCommand": "uv sync --locked",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-toolsai.jupyter",
                "cweijan.vscode-office"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "python.terminal.activateEnvironment": true
            }
        }
    }
}
